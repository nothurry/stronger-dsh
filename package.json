{
  "name": "dsh-ui-stronger",
  "version": "0.19.38",
  "description": "DeepSeek Harness 界面、动效、技能、知识库、人设与执行前安全审查增强。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-brand-official",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-agent-preset",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "prepublishOnly": "node lib/check-public.js",
    "build:rewind": "node scripts/build-rewind.mjs"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.3 <0.3.0-0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ui",
    "theme",
    "animation",
    "voice",
    "pet"
  ],
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nothurry/stronger-dsh.git"
  },
  "homepage": "https://github.com/nothurry/stronger-dsh#readme",
  "bugs": {
    "url": "https://github.com/nothurry/stronger-dsh/issues"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-commands": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-fs": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "dependencies": {
    "dsh-plugin-clawbot": "0.6.0",
    "qrcode": "1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
